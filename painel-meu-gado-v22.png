<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Meu Gado — Gestão Profissional do Rebanho</title>
<meta name="mg-build" content="index-v36-dashboard-real-v22">
<style>
:root{
  --green:#148b45;
  --green-2:#0f6e37;
  --green-3:#30ad61;
  --dark:#05292a;
  --dark-2:#07383a;
  --ink:#102635;
  --muted:#6b7b88;
  --line:#dfe7e4;
  --soft:#f4f8f5;
  --white:#fff;
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;color:var(--ink);background:#eef4f0}
button,input{font:inherit}
button{cursor:pointer}
.page{min-height:100vh;position:relative;background:
  linear-gradient(90deg,rgba(3,32,31,.82) 0%,rgba(3,32,31,.68) 46%,rgba(3,32,31,.26) 68%,rgba(3,32,31,.12) 100%),
  url('/login-rebanho.jpg') center/cover no-repeat fixed;
}
.shell{min-height:100vh;display:grid;grid-template-columns:minmax(0,1.22fr) minmax(420px,.78fr);gap:34px;padding:34px 48px}
.hero{color:#fff;display:flex;flex-direction:column;min-width:0}
.brand{display:flex;gap:16px;align-items:center}
.brand-logo{width:76px;height:76px;border-radius:20px;overflow:hidden;border:2px solid rgba(255,255,255,.28);background:#fff;box-shadow:0 12px 30px rgba(0,0,0,.24)}
.brand-logo img{width:100%;height:100%;object-fit:cover}
.brand b{font-size:27px;letter-spacing:-.02em;display:block}
.brand b span{color:#45c473}
.brand small{display:block;margin-top:5px;font-size:11px;letter-spacing:.11em;color:#e1ece8}
.hero-copy{margin-top:auto;margin-bottom:34px;max-width:780px}
.hero-copy h1{font-size:62px;line-height:1.01;letter-spacing:-.045em;margin:0 0 22px;max-width:730px}
.hero-copy h1 span{color:#45c473}
.hero-copy .question{font-size:20px;line-height:1.45;font-weight:850;max-width:650px;margin:0 0 11px}
.hero-copy .lead{font-size:17px;line-height:1.58;color:#eaf4ef;max-width:650px;margin:0}
.feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:26px;max-width:790px}
.feature{min-height:150px;padding:18px 16px;border-radius:16px;background:linear-gradient(180deg,rgba(12,55,42,.68),rgba(7,42,34,.82));border:1px solid rgba(255,255,255,.13);backdrop-filter:blur(7px);box-shadow:0 10px 28px rgba(0,0,0,.12)}
.feature-icon{font-size:29px;margin-bottom:13px}
.feature b{font-size:13px;display:block;margin-bottom:7px}
.feature p{font-size:11px;line-height:1.45;color:#dbe9e3;margin:0}
.result-banner{margin-top:20px;max-width:790px;padding:18px 20px;border-radius:16px;background:rgba(8,54,38,.78);border:1px solid rgba(255,255,255,.12);display:flex;gap:14px;align-items:center}
.trophy{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:#178e48;font-size:22px;flex:0 0 auto}
.result-banner b{font-size:14px}.result-banner b span{color:#4bcd77}.result-banner p{margin:4px 0 0;font-size:12px;color:#dceae4}
.trust-row{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;max-width:790px;margin-top:20px}
.trust{border:1px solid rgba(255,255,255,.10);background:rgba(6,39,34,.68);padding:13px 15px;border-radius:12px;font-size:11px;font-weight:800;display:flex;gap:9px;align-items:center}
.trust i{font-style:normal;font-size:19px;color:#4bcd77}

.login-wrap{display:grid;place-items:center}
.login-card{width:min(510px,100%);background:rgba(255,255,255,.97);border-radius:24px;padding:36px 34px 26px;box-shadow:0 28px 80px rgba(0,24,20,.24);border:1px solid rgba(255,255,255,.55)}
.card-head{text-align:center}
.card-head h2{font-size:32px;letter-spacing:-.03em;margin:0;color:#0a362d}
.card-head p{font-size:14px;line-height:1.5;color:var(--muted);margin:10px auto 0;max-width:330px}
.divider{display:flex;align-items:center;gap:13px;margin:26px 0 20px;color:#78938a}
.divider:before,.divider:after{content:"";height:1px;background:#9cc8ab;flex:1}
.divider .mini-cow{font-size:20px}
.tabs{display:grid;grid-template-columns:1fr 1fr;gap:6px;padding:5px;background:#eef5f0;border-radius:12px;margin-bottom:18px}
.tab{border:0;padding:10px;border-radius:9px;background:transparent;color:#667970;font-weight:800}
.tab.active{background:#fff;color:var(--green);box-shadow:0 4px 12px rgba(17,71,45,.08)}
.form{display:none}.form.active{display:block}
.field{margin:13px 0}
.field-top{display:flex;justify-content:space-between;align-items:center}
.field label{font-size:12px;font-weight:850;display:block;margin-bottom:7px}
.field input{width:100%;padding:13px 14px;border:1px solid #dbe5df;border-radius:10px;outline:none;background:#fff}
.field input:focus{border-color:#7dc594;box-shadow:0 0 0 3px #eaf7ee}
.row{display:grid;grid-template-columns:1fr 92px;gap:9px}
.forgot{border:0;background:transparent;color:var(--green);padding:0;font-size:11px;font-weight:800}
.remember{display:flex;align-items:center;gap:8px;font-size:11px;color:#687b71;margin:10px 0 3px}
.remember input{width:auto;accent-color:var(--green)}
.btn{width:100%;border:0;border-radius:11px;padding:13px 16px;background:linear-gradient(135deg,#0e503f,#063d34);color:#fff;font-weight:900;font-size:14px;margin-top:10px;box-shadow:0 9px 22px rgba(7,62,48,.18)}
.btn.green{background:linear-gradient(135deg,#1e9b50,#147d40)}
.or{display:flex;align-items:center;gap:12px;color:#87978f;font-size:11px;margin:19px 0}
.or:before,.or:after{content:"";height:1px;background:#d7e2dc;flex:1}
.signup-card{padding:18px;border-radius:16px;background:linear-gradient(180deg,#f2f8f4,#edf6f0);border:1px solid #deebe2;text-align:center}
.signup-icon{width:48px;height:48px;border-radius:50%;margin:0 auto 9px;display:grid;place-items:center;border:2px solid var(--green);color:var(--green);font-size:22px}
.signup-card h3{font-size:18px;margin:0 0 5px;color:#103a30}.signup-card p{font-size:11px;line-height:1.45;color:#687b72;margin:0 0 12px}
.outline{width:100%;border:1.5px solid var(--green);background:#fff;color:var(--green);border-radius:10px;padding:11px;font-weight:900}
.help{text-align:center;margin-top:15px;font-size:11px;color:#75867e}.help span{color:var(--green);font-weight:800}
.error{font-size:12px;color:#b44038;margin-top:10px;line-height:1.4;min-height:17px}.success{color:#167d42}
.footer{text-align:center;color:#a0aaa5;font-size:10px;margin-top:12px}

@media(max-width:1150px){
  .shell{grid-template-columns:1fr;padding:26px}.hero{min-height:690px}.hero-copy{margin-top:90px}.login-wrap{padding-bottom:30px}.login-card{max-width:600px}
}
@media(max-width:720px){
  .page{background-attachment:scroll}.shell{padding:18px;gap:20px}.hero{min-height:560px}.brand-logo{width:58px;height:58px;border-radius:16px}.brand b{font-size:22px}.hero-copy{margin-top:70px}.hero-copy h1{font-size:43px}.hero-copy .question{font-size:17px}.hero-copy .lead{font-size:14px}.feature-grid{grid-template-columns:repeat(2,1fr)}.trust-row{grid-template-columns:1fr}.login-card{padding:28px 20px}.row{grid-template-columns:1fr}
}

.password-wrap{position:relative}
.password-wrap input{padding-right:78px!important}
.show-pass{position:absolute;right:8px;top:50%;transform:translateY(-50%);border:0;background:transparent;color:#148b45;font-size:11px;font-weight:800;padding:5px 7px}

/* V3.2 — logo oficial no acesso */
.logo img,.login-logo img,.brand-logo img{
  object-fit:cover!important;
  object-position:center!important;
  border-radius:50%!important;
}


.legal-consent{font-size:10px;line-height:1.55;color:#687872;margin:10px 0 12px;text-align:center}
.legal-consent a,.legal-links a{color:#0b7f49;font-weight:800;text-decoration:none}
.legal-links{text-align:center;font-size:10px;color:#74827d;margin-top:10px}
.legal-modal{position:fixed;inset:0;background:rgba(4,22,17,.62);z-index:9999;display:none;align-items:center;justify-content:center;padding:18px}
.legal-modal.open{display:flex}
.legal-card{width:min(900px,100%);max-height:88vh;overflow:auto;background:#fff;border-radius:18px;padding:24px;box-shadow:0 24px 80px rgba(0,0,0,.28);color:#263a33}
.legal-card h2{margin:0 0 4px}.legal-card h3{margin-top:20px}.legal-card p{font-size:12px;line-height:1.65}
.legal-head{display:flex;justify-content:space-between;gap:16px;align-items:flex-start}.legal-close{border:1px solid #d8e2dd;background:#fff;border-radius:10px;padding:9px 13px;cursor:pointer;font-weight:800}


/* V24 — cadastro em etapas + onboarding da propriedade */
.stepper{display:flex;align-items:center;justify-content:center;gap:8px;margin:0 0 18px}
.step-dot{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:#e7efe9;color:#728077;font-size:11px;font-weight:900}
.step-dot.active{background:var(--green);color:#fff}
.step-line{width:42px;height:2px;background:#d7e2dc}
.onboarding-note{font-size:11px;line-height:1.5;color:#687b72;background:#f2f8f4;border:1px solid #deebe2;border-radius:11px;padding:11px 12px;margin:10px 0}
.field select{width:100%;padding:13px 14px;border:1px solid #dbe5df;border-radius:10px;outline:none;background:#fff;color:var(--ink)}
.field select:focus{border-color:#7dc594;box-shadow:0 0 0 3px #eaf7ee}
.optional{font-size:9px;font-weight:700;color:#91a098;margin-left:4px}
.form-actions{display:flex;gap:9px}
.form-actions .btn{margin-top:10px}
.secondary-btn{background:#fff!important;color:var(--green)!important;border:1.5px solid var(--green)!important;box-shadow:none!important}


/* V26 — múltiplas atividades da propriedade */
.activity-options{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:8px;
  margin-top:8px;
}
.activity-option{
  display:flex;
  align-items:center;
  gap:8px;
  border:1px solid #dbe5df;
  border-radius:10px;
  padding:10px 11px;
  background:#fff;
  font-size:11px;
  font-weight:750;
  color:#385048;
  cursor:pointer;
}
.activity-option:hover{border-color:#8cc9a0;background:#f6fbf7}
.activity-option input{width:auto;margin:0;accent-color:var(--green)}
@media(max-width:520px){.activity-options{grid-template-columns:1fr}}


/* V28 — recuperação de senha */
.password-help-box{
  background:#f2f8f4;border:1px solid #deebe2;border-radius:12px;
  padding:12px 13px;margin:10px 0 14px;font-size:11px;line-height:1.55;color:#60736a
}
.back-link{
  width:100%;border:0;background:transparent;color:var(--green);
  font-weight:850;font-size:11px;margin-top:10px;padding:6px
}


.password-rules{font-size:10px;color:#718078;line-height:1.45;margin-top:6px}


/* V33 — Cloudflare Turnstile */
.captcha-wrap{display:flex;justify-content:center;min-height:65px;margin:10px 0 4px}
.captcha-note{font-size:9.5px;color:#7b8982;text-align:center;line-height:1.4;margin:3px 0 8px}

/* V20 — nova página comercial */
html{scroll-behavior:smooth}
.page{background:#fff;overflow:hidden}
.site-header{height:76px;display:flex;align-items:center;justify-content:space-between;padding:0 max(24px,calc((100vw - 1400px)/2));background:rgba(255,255,255,.96);border-bottom:1px solid #e6ece8;position:relative;z-index:20}
.site-brand{display:flex;align-items:center;gap:11px;color:#092f26;text-decoration:none;font-size:22px;font-weight:950}
.site-brand img{width:52px;height:52px;border-radius:50%;object-fit:cover;border:2px solid #e3b94d}
.site-nav{display:flex;gap:34px;align-items:center}.site-nav a{color:#30463e;text-decoration:none;font-size:13px;font-weight:800}.site-nav a:hover{color:var(--green)}
.header-actions{display:flex;gap:10px}.header-btn{border-radius:9px;padding:10px 18px;font-size:12px;font-weight:900;border:1px solid var(--green);background:#fff;color:var(--green)}.header-btn.primary{background:var(--green);color:#fff;box-shadow:0 8px 20px rgba(20,139,69,.18)}
.shell{min-height:auto;display:block;padding:0}
.hero{min-height:640px;padding:64px max(24px,calc((100vw - 1400px)/2));display:grid;grid-template-columns:minmax(420px,.86fr) minmax(600px,1.14fr);gap:44px;align-items:center;color:#092f26;background:linear-gradient(90deg,rgba(255,253,246,.97) 0%,rgba(255,253,246,.91) 40%,rgba(255,253,246,.48) 62%,rgba(255,253,246,.08) 100%),url('/hero-meu-gado-v20.webp') center/cover no-repeat}
.hero-copy{margin:0;max-width:640px}.eyebrow{display:inline-flex;align-items:center;gap:7px;border-radius:999px;background:#f4eedb;color:#08763c;padding:8px 13px;font-size:10px;font-weight:950;letter-spacing:.045em;margin-bottom:20px}
.hero-copy h1{font-size:54px;line-height:1.03;letter-spacing:-.045em;margin:0 0 17px;max-width:620px;color:#062f26}.hero-copy h1 span{color:inherit}.hero-copy .lead{font-size:17px;line-height:1.6;color:#40564e;max-width:580px;margin:0}
.hero-actions{display:flex;gap:12px;margin:26px 0 18px}.hero-cta{border:0;border-radius:10px;padding:14px 21px;background:var(--green);color:#fff;font-size:13px;font-weight:950;box-shadow:0 10px 24px rgba(20,139,69,.23)}.hero-cta.secondary{background:#fff;color:#173d33;border:1px solid #8aa098;box-shadow:none}
.hero-trust{display:flex;flex-wrap:wrap;gap:18px;font-size:11px;color:#365148;font-weight:800}.hero-trust span:before{content:'✓';display:inline-grid;place-items:center;width:18px;height:18px;margin-right:6px;border-radius:50%;background:#0e7440;color:#fff}
.product-stage{position:relative;min-height:455px;display:flex;align-items:center;justify-content:center}.browser-demo{width:94%;background:#fff;border:9px solid #18211f;border-top-width:25px;border-radius:17px;box-shadow:0 30px 60px rgba(3,30,24,.32);overflow:hidden;transform:perspective(1200px) rotateY(-3deg)}
.browser-demo:before{content:'';position:absolute;width:8px;height:8px;border-radius:50%;background:#42504c;top:9px;left:50%;z-index:2}.dashboard-shot{display:block;width:100%;height:342px;object-fit:cover;object-position:top left;background:#f4f7f5}
.demo-top{height:35px;background:#073b32;color:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 15px;font-size:10px;font-weight:900}.demo-body{display:grid;grid-template-columns:120px 1fr;min-height:315px}.demo-side{background:#062e2c;color:#d7ebe3;padding:17px 12px}.demo-side b{display:block;color:#fff;margin-bottom:18px}.demo-side span{display:block;font-size:9px;padding:8px 3px;border-bottom:1px solid rgba(255,255,255,.05)}.demo-main{padding:17px;background:#f4f7f5}.demo-main h3{font-size:15px;margin:0 0 4px}.demo-main>p{font-size:9px;color:#6c7d76;margin:0 0 13px}.demo-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.demo-stat{background:#fff;border:1px solid #e0e8e3;border-radius:8px;padding:11px}.demo-stat small{font-size:7px;color:#687a72;display:block}.demo-stat strong{font-size:15px;display:block;margin-top:6px;color:#0a352b}.demo-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:9px;margin-top:9px}.demo-card{background:#fff;border:1px solid #e0e8e3;border-radius:8px;padding:11px;min-height:126px}.demo-card b{font-size:9px}.task{font-size:8px;padding:8px 0;border-bottom:1px solid #edf1ef;color:#42574f}.chart{height:76px;margin-top:15px;position:relative;border-bottom:1px solid #dfe7e2;background:linear-gradient(165deg,transparent 48%,#1ba157 49%,#1ba157 51%,transparent 52%)}
.phone-demo{position:absolute;right:0;bottom:8px;width:155px;background:#fff;border:7px solid #17221f;border-radius:25px;box-shadow:0 20px 40px rgba(0,0,0,.26);padding:14px 9px 11px}.phone-demo h4{margin:0 0 10px;font-size:10px;color:#0c3a30}.phone-stat{border:1px solid #e2e9e5;border-radius:7px;padding:8px;margin:6px 0;font-size:8px;color:#667871}.phone-stat b{display:block;font-size:13px;color:#0b342b;margin-top:3px}
.benefits{padding:36px max(24px,calc((100vw - 1400px)/2)) 28px;background:#fff;text-align:center}.benefits h2,.steps h2{font-size:27px;letter-spacing:-.03em;color:#082f27;margin:0 0 25px}.benefit-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.benefit{padding:20px 18px;text-align:left;border:1px solid #e1e8e4;border-radius:13px;box-shadow:0 8px 25px rgba(12,54,42,.06)}.benefit-icon{font-size:25px;margin-bottom:10px}.benefit b{display:block;font-size:13px;color:#163e34;margin-bottom:5px}.benefit p{font-size:10.5px;line-height:1.5;color:#677970;margin:0}
.steps{padding:40px max(24px,calc((100vw - 1400px)/2));background:#063d32;color:#fff;text-align:center}.steps h2{color:#fff}.step-grid{display:grid;grid-template-columns:repeat(3,1fr);max-width:950px;margin:auto}.step{padding:5px 34px;position:relative}.step:not(:last-child):after{content:'›';position:absolute;right:-4px;top:13px;font-size:34px;color:#67b889}.step-number{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;margin:0 auto 12px;border:2px solid #53b778;color:#fff;font-size:19px;font-weight:950}.step b{display:block;font-size:15px;margin-bottom:5px}.step p{font-size:11px;line-height:1.5;color:#d4e5df;margin:0}
.login-wrap{position:fixed;inset:0;z-index:1000;display:none;place-items:center;padding:18px;background:rgba(3,27,23,.76);backdrop-filter:blur(7px);overflow:auto}.login-wrap.open{display:grid}.login-card{position:relative;max-height:94vh;overflow:auto}.modal-close{position:absolute;right:18px;top:16px;width:32px;height:32px;border:1px solid #dce5e0;background:#fff;border-radius:9px;color:#587068;font-size:18px;z-index:2}.auth-brand{display:flex;justify-content:center;align-items:center;gap:9px;margin-bottom:16px}.auth-brand img{width:46px;height:46px;border-radius:50%;object-fit:cover;border:2px solid #dcb84c}.auth-brand b{display:block;color:#073b31;font-size:16px}.auth-brand small{display:block;color:#718079;font-size:9px;margin-top:2px}
body.modal-open{overflow:hidden}
@media(max-width:1050px){.site-nav{display:none}.hero{grid-template-columns:1fr;padding-top:48px}.hero-copy{text-align:center;margin:auto}.hero-copy .lead{margin:auto}.hero-actions,.hero-trust{justify-content:center}.product-stage{min-height:410px}.benefit-grid{grid-template-columns:repeat(2,1fr)}.benefit:last-child{grid-column:1/-1}}
@media(max-width:650px){.site-header{height:66px}.site-brand img{width:44px;height:44px}.site-brand{font-size:19px}.header-actions .primary{display:none}.header-btn{padding:9px 14px}.hero{display:block;min-height:auto;padding:45px 18px 35px}.hero-copy h1{font-size:39px}.hero-copy .lead{font-size:14px}.hero-actions{flex-direction:column}.hero-cta{width:100%}.hero-trust{display:grid;gap:10px;text-align:left;margin:0 auto;max-width:220px}.product-stage{min-height:330px;margin-top:25px}.browser-demo{width:100%;border-width:6px;border-top-width:20px}.demo-body{grid-template-columns:78px 1fr;min-height:230px}.demo-side{padding:10px 7px}.demo-stats{grid-template-columns:repeat(2,1fr)}.demo-stat:nth-child(n+3){display:none}.demo-grid{grid-template-columns:1fr}.demo-grid .demo-card:last-child{display:none}.phone-demo{width:120px}.benefit-grid,.step-grid{grid-template-columns:1fr}.steps .step{margin-bottom:25px}.step:not(:last-child):after{display:none}}

</style>
