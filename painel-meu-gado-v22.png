<body>
<div class="page">
  <header class="site-header">
    <a class="site-brand" href="#inicio"><img src="/meu-gado-logo.png" alt="Logotipo Meu Gado"><span>Meu Gado</span></a>
    <nav class="site-nav"><a href="#recursos">Recursos</a><a href="#como-funciona">Como funciona</a><a href="#para-quem">Para quem é</a><a href="mailto:contatomeugado@outlook.com">Contato</a></nav>
    <div class="header-actions"><button class="header-btn" onclick="openAuth('login')">Entrar</button><button class="header-btn primary" onclick="openAuth('register')">Começar gratuitamente</button></div>
  </header>
  <div class="shell">
    <section class="hero" id="inicio">
      <div class="hero-copy">
        <div class="eyebrow">🌿 GESTÃO PECUÁRIA SIMPLES E INTELIGENTE</div>
        <h1>Seu rebanho organizado. Suas decisões mais lucrativas.</h1>
        <p class="lead">Controle animais, pesagens, saúde, reprodução, lotes e gastos. Acompanhe gráficos, cotações regionais e notícias do setor em um só lugar.</p>
        <div class="hero-actions"><button class="hero-cta" onclick="openAuth('register')">Começar gratuitamente →</button><button class="hero-cta secondary" onclick="document.getElementById('recursos').scrollIntoView()">▶ &nbsp;Ver como funciona</button></div>
        <div class="hero-trust"><span>Fácil de usar</span><span>Acesso pelo celular</span><span>Dados protegidos</span></div>
      </div>
      <div class="product-stage" aria-label="Demonstração do painel Meu Gado">
        <div class="browser-demo"><img class="dashboard-shot" src="/painel-meu-gado-v22.png" alt="Painel real do Meu Gado com 28 animais, gráficos de desempenho, mercado pecuário e gastos por alimentação"></div>
        <div class="phone-demo"><h4>Resumo da fazenda</h4><div class="phone-stat">Total de animais<b>28</b></div><div class="phone-stat">Peso médio<b>193,8 kg</b></div><div class="phone-stat">GMD médio<b>0,032 kg/dia</b></div></div>
      </div>
    </section>

    <section class="login-wrap">
      <div class="login-card">
        <button class="modal-close" onclick="closeAuth()" aria-label="Fechar">×</button>
        <div class="auth-brand"><img src="/meu-gado-logo.png" alt="Meu Gado"><div><b>Meu Gado</b><small>Gestão pecuária inteligente</small></div></div>
        <div class="card-head">
          <h2 id="title">Bem-vindo de volta!</h2>
          <p id="subtitle">Acesse sua conta e continue cuidando do que mais importa: seu rebanho.</p>
        </div>
        <div class="divider"><span></span><div class="mini-cow">🐂</div><span></span></div>

        <div class="tabs" id="tabs">
          <button class="tab active" id="loginTab" onclick="switchTab('login')">Entrar</button>
          <button class="tab" id="registerTab" onclick="switchTab('register')">Criar minha conta</button>
        </div>

        <div class="form active" id="loginForm">
          <div class="field"><label>E-mail</label><input id="loginEmail" type="email" autocomplete="username" placeholder="seu@email.com"></div>
          <div class="field"><div class="field-top"><label>Senha</label><button class="forgot" onclick="forgotPassword()">Esqueci minha senha</button></div><div class="password-wrap"><input id="loginPassword" type="password" autocomplete="current-password" placeholder="Sua senha"><button type="button" class="show-pass" onclick="togglePassword('loginPassword',this)">Mostrar</button></div></div>
          <label class="remember"><input id="rememberMe" type="checkbox" checked> Lembrar de mim</label>
          <div class="captcha-wrap"><div id="turnstileLogin"></div></div>
          <div class="captcha-note">Verificação de segurança contra acessos automatizados.</div>
          <button class="btn" onclick="doLogin()">🔒 &nbsp; Entrar</button>

          <div class="or">ou</div>

          <div class="signup-card">
            <div class="signup-icon">👤</div>
            <h3>Ainda não usa o Meu Gado?</h3>
            <p>Comece agora a transformar os dados da sua fazenda em resultado.</p>
            <button class="outline" onclick="switchTab('register')">👤+ &nbsp; Criar minha conta</button>
          </div>
        </div>

        <div class="form" id="registerForm">
          <div class="stepper" aria-label="Etapas do cadastro">
            <div class="step-dot active">1</div><div class="step-line"></div><div class="step-dot">2</div>
          </div>
          <div class="onboarding-note"><b>Etapa 1 de 2 — Crie sua conta.</b><br>Primeiro cadastramos o responsável. Os dados da propriedade serão informados depois do primeiro acesso.</div>
          <div class="field"><label>Nome completo</label><input id="regName" autocomplete="name" placeholder="Nome do responsável"></div>
          <div class="field"><label>CPF/CNPJ</label><input id="regDoc" inputmode="numeric" placeholder="CPF ou CNPJ"></div>
          <div class="field"><label>E-mail</label><input id="regEmail" type="email" autocomplete="email" placeholder="seu@email.com"></div>
          <div class="field"><label>Telefone / WhatsApp</label><input id="regPhone" inputmode="tel" placeholder="(00) 00000-0000"></div>
          <div class="field"><label>Crie uma senha</label><div class="password-wrap"><input id="regPassword" type="password" autocomplete="new-password" placeholder="Mínimo de 10 caracteres"><button type="button" class="show-pass" onclick="togglePassword('regPassword',this)">Mostrar</button></div><div class="password-rules">Use pelo menos 10 caracteres, com letra maiúscula, letra minúscula, número e símbolo.</div></div>
          <div class="field"><label>Confirme sua senha</label><div class="password-wrap"><input id="regPasswordConfirm" type="password" autocomplete="new-password" placeholder="Digite a senha novamente"><button type="button" class="show-pass" onclick="togglePassword('regPasswordConfirm',this)">Mostrar</button></div></div>
          <div class="captcha-wrap"><div id="turnstileRegister"></div></div>
          <div class="captcha-note">Verificação de segurança contra cadastros automatizados.</div>
          <button class="btn green" onclick="doRegister()">Criar minha conta</button>
          <div class="legal-consent">Ao criar sua conta, você declara que leu e concorda com os
            <a href="#" onclick="openTerms();return false">Termos de Uso</a> e com a
            <a href="#" onclick="openPrivacy();return false">Política de Privacidade</a>.
          </div>
        </div>

        <div class="form" id="onboardingForm">
          <div class="stepper" aria-label="Etapas do cadastro">
            <div class="step-dot">✓</div><div class="step-line"></div><div class="step-dot active">2</div>
          </div>
          <div class="onboarding-note"><b>Etapa 2 de 2 — Configure sua propriedade.</b><br>Essas informações organizam o painel e podem ser atualizadas depois.</div>

          <div class="field"><label>Nome da propriedade</label><input id="onFarmName" placeholder="Ex.: Fazenda Boa Vista"></div>
          <div class="row"><div class="field"><label>Cidade</label><input id="onCity" placeholder="Cidade"></div><div class="field"><label>UF</label><input id="onState" maxlength="2" placeholder="MG"></div></div>

          <div class="field"><label>Tipo de pecuária</label>
            <select id="onLivestockMode">
              <option value="beef">Pecuária de corte</option>
              <option value="dairy">Pecuária de leite</option>
              <option value="mixed">Mista</option>
            </select>
          </div>

          <div class="field">
            <label>Atividades da propriedade <span class="optional">(marque uma ou mais)</span></label>
            <div class="activity-options" id="onOperationOptions">
              <label class="activity-option"><input type="checkbox" name="onOperation" value="Cria"> Cria</label>
              <label class="activity-option"><input type="checkbox" name="onOperation" value="Recria"> Recria</label>
              <label class="activity-option"><input type="checkbox" name="onOperation" value="Engorda"> Engorda</label>
              <label class="activity-option"><input type="checkbox" name="onOperation" value="Confinamento"> Confinamento</label>
              <label class="activity-option"><input type="checkbox" name="onOperation" value="Leite"> Leite</label>
              <label class="activity-option"><input type="checkbox" name="onOperation" value="Ciclo completo"> Ciclo completo</label>
              <label class="activity-option"><input type="checkbox" name="onOperation" value="Outra"> Outra</label>
            </div>
          </div>

          <div class="field"><label>Área da propriedade <span class="optional">(opcional)</span></label><input id="onArea" type="number" min="0" step="0.01" inputmode="decimal" placeholder="Hectares"></div>
          <div class="field"><label>Endereço <span class="optional">(opcional)</span></label><input id="onAddress" placeholder="Estrada, comunidade, zona rural..."></div>
          <div class="field"><label>Inscrição Estadual <span class="optional">(opcional)</span></label><input id="onStateRegistration" placeholder="Inscrição do produtor/empresa"></div>
          <div class="field"><label>CAR <span class="optional">(opcional)</span></label><input id="onCar" placeholder="Cadastro Ambiental Rural"></div>

          <button class="btn green" onclick="completeOnboarding()">Concluir configuração</button>
          <button class="btn secondary-btn" onclick="doLogoutFromOnboarding()">Sair e concluir depois</button>
        </div>

        
        <div class="form" id="forgotForm">
          <div class="password-help-box">
            <b>Recuperar acesso</b><br>
            Informe o e-mail da sua conta. Se ele estiver cadastrado, enviaremos um link para criar uma nova senha.
          </div>
          <div class="field"><label>E-mail</label><input id="forgotEmail" type="email" autocomplete="email" placeholder="seu@email.com"></div>
          <div class="captcha-wrap"><div id="turnstileForgot"></div></div>
          <div class="captcha-note">Verificação de segurança para proteger a recuperação de conta.</div>
          <button class="btn green" id="forgotSendBtn" onclick="sendPasswordReset()">Enviar link de recuperação</button>
          <button class="back-link" onclick="backToLogin()">← Voltar para o login</button>
        </div>

        <div class="form" id="resetPasswordForm">
          <div class="password-help-box">
            <b>Crie uma nova senha</b><br>
            Use uma senha com pelo menos 10 caracteres e diferente da senha anterior.
          </div>
          <div class="field"><label>Nova senha</label><div class="password-wrap"><input id="resetPassword" type="password" autocomplete="new-password" placeholder="Mínimo de 10 caracteres"><button type="button" class="show-pass" onclick="togglePassword('resetPassword',this)">Mostrar</button></div><div class="password-rules">Use pelo menos 10 caracteres, com letra maiúscula, letra minúscula, número e símbolo.</div></div>
          <div class="field"><label>Confirmar nova senha</label><div class="password-wrap"><input id="resetPasswordConfirm" type="password" autocomplete="new-password" placeholder="Digite a senha novamente"><button type="button" class="show-pass" onclick="togglePassword('resetPasswordConfirm',this)">Mostrar</button></div></div>
          <button class="btn green" id="resetPasswordBtn" onclick="saveNewPassword()">Salvar nova senha</button>
        </div>

        <div class="form" id="setupForm">
          <div class="field"><label>Nome do proprietário do sistema</label><input id="setupName"></div>
          <div class="field"><label>E-mail do administrador</label><input id="setupEmail" type="email"></div>
          <div class="field"><label>Crie sua senha de administrador</label><input id="setupPassword" type="password" placeholder="Mínimo de 10 caracteres"></div>
          <button class="btn green" onclick="setupAdmin()">Criar administrador</button>
        </div>

        <div class="error" id="message"></div>
        <div class="help">💬 Precisa de ajuda? <span>Fale conosco</span></div>
        <div class="footer">© 2026 Meu Gado. Todos os direitos reservados.</div>
        <div class="legal-links"><a href="#" onclick="openTerms();return false">Termos de Uso</a> · <a href="#" onclick="openPrivacy();return false">Política de Privacidade</a> · <a href="mailto:contatomeugado@outlook.com">Contato</a></div>
      </div>
    </section>
  </div>
  <section class="benefits" id="recursos">
    <h2>Tudo o que você precisa para cuidar melhor do rebanho</h2>
    <div class="benefit-grid">
      <article class="benefit"><div class="benefit-icon">🐂</div><b>Controle do rebanho</b><p>Tenha identificação, lote e histórico completo de cada animal.</p></article>
      <article class="benefit"><div class="benefit-icon">🛡️</div><b>Saúde em dia</b><p>Acompanhe vacinas, medicamentos e tratamentos sem esquecimento.</p></article>
      <article class="benefit"><div class="benefit-icon">📊</div><b>Pesagem e desempenho</b><p>Visualize ganho de peso, GMD e evolução das metas.</p></article>
      <article class="benefit"><div class="benefit-icon">📈</div><b>Mercado pecuário</b><p>Acompanhe cotações regionais e notícias confiáveis.</p></article>
      <article class="benefit"><div class="benefit-icon">💰</div><b>Gestão financeira</b><p>Registre os gastos e entenda os custos da propriedade.</p></article>
    </div>
  </section>
  <section class="steps" id="como-funciona">
    <h2>Da anotação à decisão em poucos passos</h2>
    <div class="step-grid">
      <article class="step"><div class="step-number">1</div><b>Cadastre</b><p>Registre seus animais, lotes e informações da propriedade.</p></article>
      <article class="step"><div class="step-number">2</div><b>Acompanhe</b><p>Mantenha os dados atualizados e receba os alertas importantes.</p></article>
      <article class="step"><div class="step-number">3</div><b>Decida melhor</b><p>Use indicadores claros para tomar decisões mais seguras.</p></article>
    </div>
    <div id="para-quem" style="margin:32px auto 0;padding-top:28px;border-top:1px solid rgba(255,255,255,.14);max-width:950px">
      <b style="font-size:16px">Feito para quem vive a pecuária todos os dias</b>
      <p style="font-size:12px;color:#d4e5df;margin:7px 0 16px">Produtores de corte, leite, cria, recria, engorda e confinamento.</p>
      <button class="hero-cta" onclick="openAuth('register')">Criar minha conta →</button>
    </div>
  </section>
</div>

<script>
function openAuth(tab='login'){
  const modal=document.querySelector('.login-wrap');
  if(modal) modal.classList.add('open');
  document.body.classList.add('modal-open');
  if(tab==='login'||tab==='register') switchTab(tab);
}
function closeAuth(){
  const modal=document.querySelector('.login-wrap');
  if(modal) modal.classList.remove('open');
  document.body.classList.remove('modal-open');
}
function formatError(detail){
  if(typeof detail==='string') return detail;
  if(Array.isArray(detail)) return detail.map(x=>x.msg||JSON.stringify(x)).join(' | ');
  if(detail&&typeof detail==='object') return detail.msg||JSON.stringify(detail);
  return 'Erro inesperado.';
}
const mgSb=supabase.createClient(window.MG_SB_URL,window.MG_SB_KEY);

const MG_TURNSTILE_SITE_KEY='0x4AAAAAAEz18CzViJsl3lHd';
const mgCaptcha={login:null,register:null,forgot:null};
const mgCaptchaWidget={login:null,register:null,forgot:null};

function mgTurnstileReady(){
  return typeof window.turnstile!=='undefined';
}
function mgRenderCaptcha(kind){
  if(!mgTurnstileReady()){ setTimeout(()=>mgRenderCaptcha(kind),180); return; }
  const ids={login:'turnstileLogin',register:'turnstileRegister',forgot:'turnstileForgot'};
  const target=document.getElementById(ids[kind]);
  if(!target || mgCaptchaWidget[kind]!==null) return;
  mgCaptchaWidget[kind]=window.turnstile.render(target,{
    sitekey:MG_TURNSTILE_SITE_KEY,
    theme:'light',
    callback:(token)=>{mgCaptcha[kind]=token;},
    'expired-callback':()=>{mgCaptcha[kind]=null;},
    'error-callback':()=>{mgCaptcha[kind]=null;}
  });
}
function mgRequireCaptcha(kind){
  const token=mgCaptcha[kind];
  if(!token) throw new Error('Conclua a verificação de segurança antes de continuar.');
  return token;
}
function mgResetCaptcha(kind){
  mgCaptcha[kind]=null;
  if(mgTurnstileReady() && mgCaptchaWidget[kind]!==null){
    try{window.turnstile.reset(mgCaptchaWidget[kind]);}catch(_e){}
  }
}

async function mgGetMembership(){
  const r=await mgSb.from('farm_members')
    .select('farm_id,role,active')
    .eq('user_id',(await mgSb.auth.getUser()).data.user?.id||'')
    .eq('active',true)
    .limit(1);
  if(r.error) throw new Error(r.error.message);
  return (r.data||[])[0]||null;
}

async function mgNeedsOnboarding(){
  const {data:{user}}=await mgSb.auth.getUser();
  if(!user) return true;

  const membership=await mgGetMembership();
  if(membership) return false;

  // Compatibilidade: se existir fazenda antiga deste proprietário,
  // o banco já deveria ter migrado o vínculo. Se não tiver, não criamos
  // nada automaticamente; mostramos o onboarding para evitar duplicidade.
  return true;
}

function showOnboarding(user){
  document.querySelector('.login-wrap')?.classList.add('open');
  document.body.classList.add('modal-open');
  document.getElementById('tabs').style.display='none';
  document.getElementById('loginForm').classList.remove('active');
  document.getElementById('registerForm').classList.remove('active');
  document.getElementById('setupForm').classList.remove('active');
  document.getElementById('onboardingForm').classList.remove('active');
  document.getElementById('forgotForm').classList.remove('active');
  document.getElementById('resetPasswordForm').classList.remove('active');
  document.getElementById('onboardingForm').classList.add('active');
  document.getElementById('title').textContent='Configure sua propriedade';
  document.getElementById('subtitle').textContent='Falta só uma etapa para preparar seu painel do Meu Gado.';

  const meta=user?.user_metadata||{};
  if(!document.getElementById('onFarmName').value && meta.farm_name) document.getElementById('onFarmName').value=meta.farm_name;
  if(!document.getElementById('onCity').value && meta.city) document.getElementById('onCity').value=meta.city;
  if(!document.getElementById('onState').value && meta.state) document.getElementById('onState').value=meta.state;
  setMessage('');
}

async function completeOnboarding(){
  try{
    setMessage('');
    const {data:{user}}=await mgSb.auth.getUser();
    if(!user) throw new Error('Sua sessão expirou. Entre novamente.');

    const meta=user.user_metadata||{};
    const farmName=document.getElementById('onFarmName').value.trim();
    const city=document.getElementById('onCity').value.trim();
    const state=document.getElementById('onState').value.trim().toUpperCase();
    const operations=[...document.querySelectorAll('input[name="onOperation"]:checked')].map(el=>el.value);
    const livestockMode=document.getElementById('onLivestockMode').value;
    const areaRaw=document.getElementById('onArea').value.trim();

    if(!farmName) throw new Error('Informe o nome da propriedade.');
    if(!city||state.length!==2) throw new Error('Informe cidade e UF.');
    if(!operations.length) throw new Error('Selecione pelo menos uma atividade da propriedade.');

    const payload={
      p_full_name:meta.full_name||'',
      p_document:meta.document||meta.doc||'',
      p_phone:meta.phone||'',
      p_farm_name:farmName,
      p_city:city,
      p_state:state,
      p_address:document.getElementById('onAddress').value.trim()||null,
      p_operation:operations.length?operations.join(', '):null,
      p_area_hectares:areaRaw?Number(areaRaw):null,
      p_state_registration:document.getElementById('onStateRegistration').value.trim()||null,
      p_car:document.getElementById('onCar').value.trim()||null,
      p_livestock_mode:livestockMode||null
    };

    if(!payload.p_full_name||!payload.p_document) throw new Error('Os dados do responsável não foram encontrados. Saia e refaça o cadastro.');

    const r=await mgSb.rpc('complete_first_onboarding',payload);
    if(r.error) throw new Error(r.error.message);

    setMessage('Propriedade configurada com sucesso. Abrindo seu painel...',true);
    setTimeout(()=>{location.href='/app';},700);
  }catch(e){setMessage(e.message)}
}

async function doLogoutFromOnboarding(){
  await mgSb.auth.signOut();
  location.reload();
}

async function api(path,opt={}){
  const method=(opt.method||'GET').toUpperCase();
  let data={}; try{data=opt.body?JSON.parse(opt.body):{}}catch{}
  if(path==='/api/status') return {setup_required:false};
  if(path==='/api/login'){
    const captchaToken=mgRequireCaptcha('login');
    const r=await mgSb.auth.signInWithPassword({
      email:data.email,
      password:data.password,
      options:{captchaToken}
    });
    mgResetCaptcha('login');
    if(r.error) throw new Error(r.error.message==='Invalid login credentials'?'E-mail ou senha inválidos. Se esta é sua primeira vez no site online, clique em Criar minha conta.':r.error.message);
    const needs_onboarding=await mgNeedsOnboarding();
    return {ok:true,role:'client',needs_onboarding,user:r.data.user};
  }
  if(path==='/api/register'){
    const r=await mgSb.auth.signUp({
      email:data.email,
      password:data.password,
      options:{
        captchaToken:data.captchaToken,
        data:{
          full_name:data.full_name,
          document:data.document,
          phone:data.phone||'',
          email:data.email
        }
      }
    });
    if(r.error) throw new Error(r.error.message);
    if(r.data.session){
      return {ok:true,role:'client',needs_confirmation:false,needs_onboarding:true,user:r.data.user};
    }
    return {ok:true,role:'client',needs_confirmation:true};
  }
  if(path==='/api/logout'){await mgSb.auth.signOut();return {ok:true}}
  throw new Error('Operação indisponível nesta tela.');
}
function setMessage(text,ok=false){
  const m=document.getElementById('message');
  m.textContent=text||'';
  m.className=ok?'error success':'error';
}
function switchTab(which){
  document.getElementById('loginForm').classList.toggle('active',which==='login');
  document.getElementById('registerForm').classList.toggle('active',which==='register');
  document.getElementById('setupForm').classList.remove('active');
  document.getElementById('loginTab').classList.toggle('active',which==='login');
  document.getElementById('registerTab').classList.toggle('active',which==='register');
  setTimeout(()=>mgRenderCaptcha(which==='register'?'register':'login'),50);
  document.getElementById('title').textContent=which==='login'?'Bem-vindo de volta!':'Crie sua conta';
  document.getElementById('subtitle').textContent=which==='login'
    ?'Acesse sua conta e continue cuidando do que mais importa: seu rebanho.'
    :'Comece agora a organizar sua fazenda e acompanhar seu rebanho.';
  setMessage('');
}
async function init(){
  try{
    const hashParams=new URLSearchParams(location.hash.replace(/^#/,''));
    const searchParams=new URLSearchParams(location.search);
    const recoveryHint=hashParams.get('type')==='recovery'||searchParams.get('recovery')==='1';

    const {data:{session}}=await mgSb.auth.getSession();

    if(recoveryHint&&session?.user){
      showResetPassword();
      return;
    }

    if(session?.user){
      const needs=await mgNeedsOnboarding();
      if(needs){showOnboarding(session.user);return;}
      location.href='/app';
      return;
    }

    const s=await api('/api/status');
    if(s.setup_required){
      document.getElementById('tabs').style.display='none';
      document.getElementById('loginForm').classList.remove('active');
      document.getElementById('registerForm').classList.remove('active');
      document.getElementById('onboardingForm').classList.remove('active');
      document.getElementById('setupForm').classList.add('active');
      document.getElementById('title').textContent='Configuração do proprietário';
      document.getElementById('subtitle').textContent='Crie a conta administrativa exclusiva do Meu Gado.';
    }
  }catch(e){setMessage(e.message)}
}
async function doLogin(){
  try{
    setMessage('');
    const email=document.getElementById('loginEmail').value.trim();
    const password=document.getElementById('loginPassword').value;
    if(!email||!password) throw new Error('Informe e-mail e senha.');
    const j=await api('/api/login',{method:'POST',body:JSON.stringify({email,password})});
    if(j.needs_onboarding){showOnboarding(j.user);return;}
    location.href=j.role==='admin'?'/admin':'/app';
  }catch(e){setMessage(e.message)}
}

function validateStrongPassword(password){
  if(password.length<10) return 'A senha deve ter pelo menos 10 caracteres.';
  if(!/[a-z]/.test(password)) return 'A senha precisa ter pelo menos uma letra minúscula.';
  if(!/[A-Z]/.test(password)) return 'A senha precisa ter pelo menos uma letra maiúscula.';
  if(!/[0-9]/.test(password)) return 'A senha precisa ter pelo menos um número.';
  if(!/[^A-Za-z0-9]/.test(password)) return 'A senha precisa ter pelo menos um símbolo.';
  return '';
}

async function doRegister(){
  try{
    setMessage('');
    const password=document.getElementById('regPassword').value;
    const confirmPassword=document.getElementById('regPasswordConfirm').value;
    const data={
      full_name:document.getElementById('regName').value.trim(),
      document:document.getElementById('regDoc').value.trim(),
      email:document.getElementById('regEmail').value.trim(),
      phone:document.getElementById('regPhone').value.trim(),
      password
    };

    if(!data.full_name||!data.document||!data.email||!data.phone) throw new Error('Preencha nome, CPF/CNPJ, e-mail e WhatsApp.');
    const docDigits=data.document.replace(/\D/g,'');
    if(docDigits.length!==11&&docDigits.length!==14) throw new Error('Informe um CPF com 11 dígitos ou CNPJ com 14 dígitos.');
    const passwordError=validateStrongPassword(password);
    if(passwordError) throw new Error(passwordError);
    if(password!==confirmPassword) throw new Error('As senhas não conferem.');

    const availability=await mgSb.rpc('registration_identity_available',{
      p_email:data.email,
      p_document:data.document
    });
    if(availability.error) throw new Error('Não foi possível validar os dados do cadastro. Tente novamente.');
    if(availability.data!==true) throw new Error('Já existe uma conta cadastrada com este e-mail ou CPF/CNPJ.');

    const captchaToken=mgRequireCaptcha('register');
    data.captchaToken=captchaToken;
    const r=await api('/api/register',{method:'POST',body:JSON.stringify(data)});
    mgResetCaptcha('register');
    if(r.needs_confirmation){
      setMessage('Conta criada. Confirme o e-mail recebido e depois entre para configurar sua propriedade.',true);
      switchTab('login');
      return;
    }
    if(r.needs_onboarding){showOnboarding(r.user);return;}
    location.href='/app';
  }catch(e){mgResetCaptcha('register');setMessage(e.message)}
}
async function setupAdmin(){
  try{
    setMessage('');
    const fullName=document.getElementById('setupName').value.trim();
    const email=document.getElementById('setupEmail').value.trim();
    const password=document.getElementById('setupPassword').value;
    if(!fullName||!email) throw new Error('Preencha nome e e-mail.');
    const passwordError=validateStrongPassword(password);
    if(passwordError) throw new Error(passwordError);
    await api('/api/setup',{method:'POST',body:JSON.stringify({full_name:fullName,email,password})});
    location.href='/admin';
  }catch(e){setMessage(e.message)}
}

function togglePassword(id,button){
  const input=document.getElementById(id);
  if(!input)return;
  const show=input.type==='password';
  input.type=show?'text':'password';
  button.textContent=show?'Ocultar':'Mostrar';
}
function enableEnterSubmit(){
  ['loginEmail','loginPassword'].forEach(id=>{
    const el=document.getElementById(id);
    if(el)el.addEventListener('keydown',e=>{
      if(e.key==='Enter'){e.preventDefault();doLogin();}
    });
  });
  ['regName','regDoc','regEmail','regPhone','regPassword','regPasswordConfirm'].forEach(id=>{
    const el=document.getElementById(id);
    if(el)el.addEventListener('keydown',e=>{
      if(e.key==='Enter'){e.preventDefault();doRegister();}
    });
  });

  ['onFarmName','onCity','onState','onArea','onAddress','onStateRegistration','onCar'].forEach(id=>{
    const el=document.getElementById(id);
    if(el)el.addEventListener('keydown',e=>{
      if(e.key==='Enter'){e.preventDefault();completeOnboarding();}
    });
  });


  ['forgotEmail'].forEach(id=>{
    const el=document.getElementById(id);
    if(el)el.addEventListener('keydown',e=>{
      if(e.key==='Enter'){e.preventDefault();sendPasswordReset();}
    });
  });

  ['resetPassword','resetPasswordConfirm'].forEach(id=>{
    const el=document.getElementById(id);
    if(el)el.addEventListener('keydown',e=>{
      if(e.key==='Enter'){e.preventDefault();saveNewPassword();}
    });
  });

  ['setupName','setupEmail','setupPassword'].forEach(id=>{
    const el=document.getElementById(id);
    if(el)el.addEventListener('keydown',e=>{
      if(e.key==='Enter'){e.preventDefault();setupAdmin();}
    });
  });
}

let mgRecoveryMode=false;

function hideAllAuthForms(){
  ['loginForm','registerForm','onboardingForm','setupForm','forgotForm','resetPasswordForm'].forEach(id=>{
    const el=document.getElementById(id);
    if(el)el.classList.remove('active');
  });
}

function forgotPassword(){
  const current=document.getElementById('loginEmail')?.value?.trim()||'';
  hideAllAuthForms();
  document.getElementById('tabs').style.display='none';
  document.getElementById('forgotForm').classList.add('active');
  setTimeout(()=>mgRenderCaptcha('forgot'),50);
  document.getElementById('title').textContent='Esqueceu sua senha?';
  document.getElementById('subtitle').textContent='Nós enviaremos as instruções para o seu e-mail.';
  if(current)document.getElementById('forgotEmail').value=current;
  setMessage('');
}

function backToLogin(){
  hideAllAuthForms();
  document.getElementById('tabs').style.display='grid';
  document.getElementById('loginForm').classList.add('active');
  setTimeout(()=>mgRenderCaptcha('login'),50);
  document.getElementById('loginTab').classList.add('active');
  document.getElementById('registerTab').classList.remove('active');
  document.getElementById('title').textContent='Bem-vindo de volta!';
  document.getElementById('subtitle').textContent='Acesse sua conta e continue cuidando do que mais importa: seu rebanho.';
  setMessage('');
}

async function sendPasswordReset(){
  try{
    setMessage('');
    const email=document.getElementById('forgotEmail').value.trim();
    if(!email)throw new Error('Informe seu e-mail.');
    const btn=document.getElementById('forgotSendBtn');
    btn.disabled=true;btn.textContent='Enviando...';

    const redirectTo=location.origin+location.pathname+'?recovery=1';
    const captchaToken=mgRequireCaptcha('forgot');
    const {error}=await mgSb.auth.resetPasswordForEmail(email,{redirectTo,captchaToken});
    mgResetCaptcha('forgot');

    btn.disabled=false;btn.textContent='Enviar link de recuperação';
    if(error)throw error;

    setMessage('Se existir uma conta com esse e-mail, enviaremos um link para criar uma nova senha.',true);
  }catch(e){
    const btn=document.getElementById('forgotSendBtn');
    if(btn){btn.disabled=false;btn.textContent='Enviar link de recuperação'}
    mgResetCaptcha('forgot');
    setMessage(e.message||'Não foi possível enviar o e-mail de recuperação.');
  }
}

function showResetPassword(){
  document.querySelector('.login-wrap')?.classList.add('open');
  document.body.classList.add('modal-open');
  mgRecoveryMode=true;
  hideAllAuthForms();
  document.getElementById('tabs').style.display='none';
  document.getElementById('resetPasswordForm').classList.add('active');
  document.getElementById('title').textContent='Criar nova senha';
  document.getElementById('subtitle').textContent='Defina uma nova senha para voltar a acessar o Meu Gado.';
  setMessage('');
}

async function saveNewPassword(){
  try{
    setMessage('');
    const p1=document.getElementById('resetPassword').value;
    const p2=document.getElementById('resetPasswordConfirm').value;
    const passwordError=validateStrongPassword(p1);
    if(passwordError)throw new Error(passwordError);
    if(p1!==p2)throw new Error('As senhas não conferem.');

    const btn=document.getElementById('resetPasswordBtn');
    btn.disabled=true;btn.textContent='Salvando...';

    const {error}=await mgSb.auth.updateUser({password:p1});

    btn.disabled=false;btn.textContent='Salvar nova senha';
    if(error)throw error;

    setMessage('Senha alterada com sucesso. Você já pode entrar com a nova senha.',true);
    await mgSb.auth.signOut();
    history.replaceState({},'',location.pathname);
    setTimeout(()=>backToLogin(),900);
  }catch(e){
    const btn=document.getElementById('resetPasswordBtn');
    if(btn){btn.disabled=false;btn.textContent='Salvar nova senha'}
    setMessage(e.message||'Não foi possível alterar a senha.');
  }
}
mgSb.auth.onAuthStateChange((event,session)=>{
  if(event==='PASSWORD_RECOVERY'){
    showResetPassword();
  }
});

init();
enableEnterSubmit();
setTimeout(()=>mgRenderCaptcha('login'),350);
</script>

