<style>
.login-support-v19{position:static;text-align:center;font-size:11px;color:#74827d;padding:18px 14px 12px;margin-top:0;background:rgba(255,255,255,.96)}
.login-support-v19 a{color:#0b7f49;font-weight:800;text-decoration:none;margin:0 4px}
.login-support-v19 strong{color:#344b43;font-weight:800}
.support-sep{margin:0 4px;color:#b2bbb7}
@media(max-width:650px){.login-support-v19{margin:0;line-height:1.9;padding:18px 14px}.support-sep{display:none}.login-support-v19 a,.login-support-v19 strong{display:block}}
